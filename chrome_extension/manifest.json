{
  "manifest_version": 3,
  "name": "早耳字幕",
  "version": "0.1.0",
  "description": "PCで動いている早耳（hayamimi）の字幕を、Chromeのサイドパネルに表示します。音声は扱わず、早耳の字幕サーバーから文字だけを受け取ります。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1:8833/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "早耳字幕を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
